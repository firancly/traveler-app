{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs"
	},
	"dependencies": {
		"@hono/trpc-server": "^0.4.2",
		"@traveler-app/api": "workspace:*",
		"@traveler-app/auth": "workspace:*",
		"@traveler-app/db": "workspace:*",
		"@traveler-app/env": "workspace:*",
		"@trpc/server": "catalog:",
		"better-auth": "catalog:",
		"cors": "^2.8.6",
		"dotenv": "catalog:",
		"express": "^5.2.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@traveler-app/config": "workspace:*",
		"@types/bun": "catalog:",
		"@types/cors": "^2.8.19",
		"@types/express": "catalog:",
		"tsdown": "^0.22.14",
		"typescript": "^6.0.3"
	}
}
