{
	"name": "@traveler-app/db",
	"type": "module",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		},
		"./enums": {
			"default": "./prisma/generated/enums.ts"
		}
	},
	"scripts": {
		"db:push": "prisma db push",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:migrate:deploy": "prisma migrate deploy",
		"postinstall": "prisma generate",
		"db:studio": "prisma studio",
		"ingest:osm": "bun --env-file=../../apps/server/.env scripts/ingest-osm.ts"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@prisma/adapter-neon": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@traveler-app/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@traveler-app/config": "workspace:*",
		"prisma": "^7.9.1",
		"typescript": "^6.0.3"
	}
}
